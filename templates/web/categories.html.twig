{% extends 'web/base.html.twig' %}

{% block title %}{{ 'Категории'|trans }} — {{ 'Траты'|trans }}{% endblock %}

{% macro row(c, usage, admin, state) %}
    {% set error = state.editError[c.id] ?? null %}
    <form class="catrow{{ c.id == state.highlight ? ' is-new' }}" method="post" action="{{ path('web_category_save', {id: c.id}) }}" id="cat{{ c.id }}">
        <div class="catrow__fields">
            <label class="sr" for="title{{ c.id }}">{{ 'Название'|trans }}</label>
            <input id="title{{ c.id }}" class="input catrow__title" name="title" maxlength="64" required
                   value="{{ state.editTitle[c.id] ?? c.title|trans }}" {{ c.active ? '' : 'disabled' }}>
            <label class="sr" for="words{{ c.id }}">{{ 'Ключевые слова'|trans }}</label>
            <input id="words{{ c.id }}" class="input catrow__words" name="keywords" placeholder="{{ 'ключевые слова через запятую'|trans }}"
                   value="{{ state.editWords[c.id] ?? c.keywords|join(', ') }}" {{ c.active ? '' : 'disabled' }}>
        </div>
        <div class="catrow__meta">
            <span class="muted num" title="{{ 'Трат в этой категории'|trans }}">{{ usage[c.id] ?? 0 }}</span>
            {% if c.active %}<button class="button button--quiet" type="submit">{{ 'Сохранить'|trans }}</button>{% endif %}
            {% if not admin.isDefault(c) %}
                <button class="link{{ c.active ? ' link--danger' }}" type="submit" formaction="{{ path('web_category_visibility', {id: c.id}) }}"
                        name="active" value="{{ c.active ? '0' : '1' }}" formnovalidate>{{ c.active ? 'скрыть'|trans : 'вернуть'|trans }}</button>
            {% else %}
                <span class="tag" title="{{ 'Сюда попадают траты без подходящей категории'|trans }}">{{ 'по умолчанию'|trans }}</span>
            {% endif %}
        </div>
        {% if error %}<p class="error" role="alert">{{ error|message }}</p>{% endif %}
    </form>
{% endmacro %}

{% block body %}
    {% set state = {
        editError: editError ?? {},
        editTitle: editTitle ?? {},
        editWords: editWords ?? {},
        highlight: highlight ?? 0,
    } %}
    <div class="pagehead">
        <h1>{{ 'Категории'|trans }}</h1>
        <p class="hint measure">{{ 'Тип траты определяется по ключевым словам в строке: <code>17000 ашан</code> попадёт туда, где есть слово «ашан».'|trans|raw }}
            {{ 'Слово от 4 букв совпадает и по началу: <code>доставк</code> найдёт «доставка» и «доставкой».'|trans|raw }}</p>
    </div>
    {% if notice ?? null %}<p class="notice" role="status">{{ notice|message }}</p>{% endif %}

    <form class="block catadd" method="post" action="{{ path('web_category_add') }}">
        <h2>{{ 'Новая категория'|trans }}</h2>
        <div class="catadd__row">
            <div>
                <label class="label" for="new-title">{{ 'Название'|trans }}</label>
                <input id="new-title" class="input" name="title" required maxlength="64" placeholder="{{ 'Кафе'|trans }}"
                       value="{{ addTitle ?? '' }}">
            </div>
            <div>
                <label class="label" for="new-words">{{ 'Ключевые слова'|trans }}</label>
                <input id="new-words" class="input" name="keywords" placeholder="{{ 'кафе, ресторан, кофе, бар'|trans }}"
                       value="{{ addKeywords ?? '' }}">
            </div>
            <button class="button" type="submit">{{ 'Добавить'|trans }}</button>
        </div>
        {% if addError ?? null %}<p class="error" role="alert">{{ addError|message }}</p>{% endif %}
    </form>

    <section class="block">
        <div class="block__head"><h2>{{ 'В работе'|trans }}</h2><span class="muted hint">{{ 'справа — сколько трат'|trans }}</span></div>
        {% for c in active %}{{ _self.row(c, usage, admin, state) }}{% endfor %}
    </section>

    {% if hidden is not empty %}
        <section class="block">
            <div class="block__head"><h2>{{ 'Скрытые'|trans }}</h2><span class="muted hint">{{ 'старые траты в них остались'|trans }}</span></div>
            {% for c in hidden %}{{ _self.row(c, usage, admin, state) }}{% endfor %}
        </section>
    {% endif %}
{% endblock %}
