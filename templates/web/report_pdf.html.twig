{% set d = dashboard %}
{% set report = d.report %}
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<style>
    @page { margin: 18mm 16mm; }
    body { font-family: 'DejaVu Sans', sans-serif; font-size: 9.5pt; color: #27272a; }
    h1 { font-size: 17pt; margin: 0 0 2pt; color: #18181b; }
    h2 { font-size: 10.5pt; margin: 16pt 0 6pt; color: #18181b; border-bottom: 0.6pt solid #d4d4d8; padding-bottom: 3pt; }
    .muted { color: #71717a; }
    .r { text-align: right; }
    table { width: 100%; border-collapse: collapse; }
    td, th { padding: 3pt 4pt; vertical-align: top; text-align: left; }
    .total { font-size: 20pt; font-weight: bold; color: #18181b; margin: 10pt 0 0; }
    .debt { margin-top: 12pt; }
    .debt-rail td { padding: 0; height: 9pt; }
    .debt-half { background: #e4e4e7; }
    .debt-fill { background: #0f766e; height: 9pt; }
    .debt-zero { width: 1.5pt; background: #18181b; }
    .bar { background: #0f766e; height: 7pt; }
    .bars td { border-bottom: 0.4pt solid #ececee; }
    .trend { table-layout: fixed; }
    .trend td { vertical-align: bottom; text-align: center; padding: 0 2pt; }
    .trend-col { background: #99c9c3; }
    .trend-col.current { background: #0f766e; }
    .ledger td, .ledger th { border-bottom: 0.4pt solid #ececee; }
    .ledger th { color: #71717a; font-weight: normal; font-size: 8pt; }
    .footer { margin-top: 18pt; font-size: 7.5pt; color: #a1a1aa; }
</style>
</head>
<body>
<h1>Траты · {{ d.period|month_label }}</h1>
<div class="muted">Траты пересчитаны в AMD по курсу ЦБ Армении на дату каждой траты{% if display_currency().code != "AMD" %}, итоги показаны в {{ display_currency().code }} по последнему курсу{% endif %}</div>

<div class="total">{{ report.total|shown }}</div>
{% if report.pendingCount > 0 %}<div class="muted">Без курса и не в итоге: {{ report.pendingCount }}</div>{% endif %}

{% set line = d.debtLine %}
{% if line %}
    <div class="debt">
        <strong>
            {% if line.settled %}Никто никому не должен{% else %}{{ line.debtor.name }} должен(на) {{ line.creditor.name }} {{ line.amount|shown }}{% endif %}
        </strong>
        <table style="margin-top: 5pt">
            <tr>
                <td style="width: 16%" class="muted">{{ line.left.name }}</td>
                <td style="width: 68%">
                    <table class="debt-rail"><tr>
                        <td class="debt-half" style="width: 50%">
                            {% if not line.settled and line.creditorIsLeft %}
                                <table><tr><td style="width: {{ 100 - line.percent }}%"></td><td class="debt-fill" style="width: {{ line.percent }}%"></td></tr></table>
                            {% endif %}
                        </td>
                        <td class="debt-zero"></td>
                        <td class="debt-half" style="width: 50%">
                            {% if not line.settled and not line.creditorIsLeft %}
                                <table><tr><td class="debt-fill" style="width: {{ line.percent }}%"></td><td style="width: {{ 100 - line.percent }}%"></td></tr></table>
                            {% endif %}
                        </td>
                    </tr></table>
                </td>
                <td style="width: 16%" class="r muted">{{ line.right.name }}</td>
            </tr>
        </table>
        <div class="muted" style="margin-top: 3pt">Баланс за всё время на {{ generatedAt|date('d.m.Y') }}</div>
    </div>
{% endif %}

{% if report.categories is not empty %}
    <h2>По категориям</h2>
    <table class="bars">
        {% for c in report.categories %}
            <tr>
                <td style="width: 28%">{{ c.title }} <span class="muted">({{ c.count }})</span></td>
                <td style="width: 50%; vertical-align: middle">
                    <div class="bar" style="width: {{ max(d.categoryShare(c.amount.minor), 1) }}%"></div>
                </td>
                <td class="r" style="width: 22%">{{ c.amount|shown }}</td>
            </tr>
        {% endfor %}
    </table>

    <h2>По участникам</h2>
    <table class="bars">
        <tr><td class="muted"></td><td class="r muted">заплатил(а)</td><td class="r muted">доля в тратах</td></tr>
        {% for t in report.participants %}
            <tr><td>{{ t.participant.name }}</td><td class="r">{{ t.paid|shown }}</td><td class="r">{{ t.share|shown }}</td></tr>
        {% endfor %}
    </table>
{% endif %}

<h2>Последние 12 месяцев</h2>
<table class="trend">
    <tr style="height: 70pt">
        {% for p in d.trend %}
            <td style="height: 70pt">
                {% if p.percent > 0 %}<div class="trend-col{{ p.period.key == d.period.key ? ' current' }}" style="height: {{ (p.percent * 0.66)|round(1) }}pt"></div>{% endif %}
            </td>
        {% endfor %}
    </tr>
    <tr>{% for p in d.trend %}<td class="muted" style="font-size: 7.5pt">{{ p.period|month_short }}</td>{% endfor %}</tr>
</table>

{% if d.expenses is not empty %}
    <h2>Все траты месяца</h2>
    <table class="ledger">
        <tr><th>Дата</th><th>Категория</th><th>Заметка</th><th>Платил</th><th class="r">Сумма</th><th class="r">{{ display_currency().code }}</th></tr>
        {% for e in d.expenses|reverse %}
            <tr>
                <td>{{ e.spentAt|date('d.m') }}</td>
                <td>{{ e.categoryTitle }}</td>
                <td class="muted">{{ e.note }}{% if e.split.value != 'equal' %} · {{ e.split|split_label }}{% endif %}</td>
                <td>{{ e.payerName }}</td>
                <td class="r">{{ e.amount|money }}</td>
                <td class="r">{{ e.amountBase ? e.amountBase|shown_number : 'нет курса' }}</td>
            </tr>
        {% endfor %}
    </table>
{% endif %}

<div class="footer">Сформировано {{ generatedAt|date('d.m.Y') }}</div>
</body>
</html>
