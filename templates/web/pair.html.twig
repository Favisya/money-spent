{% extends 'web/base.html.twig' %}

{% block title %}{{ 'Подключение'|trans }} — {{ 'Траты'|trans }}{% endblock %}

{% block header %}{% endblock %}

{% block body %}
    <div class="pair">
        <h1>{{ 'Подключиться к общему учёту'|trans }}</h1>
        <p class="hint measure">{{ 'На главном Mac открой <strong>Траты → Доступ</strong> и нажми «Показать код».'|trans|raw }}
            {{ 'Код действует 10 минут, вводится один раз — дальше этот Mac подключается сам, пока главный включён.'|trans }}</p>
        <form class="block" method="post" action="{{ path('web_pair_submit') }}">
            <label class="label" for="pair-code">{{ 'Код'|trans }}</label>
            <input id="pair-code" class="input pair__code" name="code" inputmode="numeric" autocomplete="one-time-code"
                   required maxlength="7" pattern="\d{3}\s?\d{3}" placeholder="123 456" autofocus>
            <label class="label" for="pair-name">{{ 'Как назвать этот Mac'|trans }}</label>
            <input id="pair-name" class="input" name="name" maxlength="64" value="{{ name }}" placeholder="{{ 'Mac Алисы'|trans }}">
            {% if error %}<p class="error" role="alert">{{ error|message }}</p>{% endif %}
            <button class="button" type="submit">{{ 'Подключиться'|trans }}</button>
        </form>
    </div>
{% endblock %}
